# Release signing for Google Play — TEMPLATE.
#
# Copy this file to `android/keystore.properties` (which is gitignored) and fill
# in your real values. NEVER commit the real file or the keystore itself.
#
# 1. Generate an upload keystore once (keep it + the passwords backed up safely;
#    losing them means you can never update the app):
#
#      keytool -genkey -v -keystore party-planner-upload.jks \
#        -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
#    (Android Studio's Build > Generate Signed App Bundle wizard can also create
#     it for you.)
#
# 2. Store the .jks outside version control and point `storeFile` at it (a path
#    relative to the `android/` folder, or an absolute path).
#
# 3. Build a signed bundle:  cd android && ./gradlew bundleRelease
#    (output: android/app/build/outputs/bundle/release/app-release.aab)

storeFile=../keystore/party-planner-upload.jks
storePassword=your-keystore-password
keyAlias=upload
keyPassword=your-key-password
