Thumbs.db

# Capacitor
# The native projects (android/, ios/) ARE versioned. Their own generated
# .gitignore files exclude local build artifacts. We only ignore the web assets
# that Capacitor copies into them on sync (regenerated from the Nuxt build).
android/app/src/main/assets/public
ios/App/App/public
