# Dependencies
node_modules

# Nuxt / build output
.nuxt
.nuxtrc
.output
.data
dist
.nitro
.cache

# Local dev environment (personal, must never be committed)
.claude

# Test / coverage
coverage
.vitest

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

