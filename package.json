{
  "name": "party-planner",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "description": "Mobile app (Android/iOS via Capacitor) for planning private events. Frontend only.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "app:sync": "nuxt generate && cap sync",
    "capacitor:sync": "cap sync",
    "capacitor:android": "cap open android",
    "capacitor:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@pinia/nuxt": "^0.11.0",
    "@vueuse/core": "^13.0.0",
    "@vueuse/nuxt": "^13.0.0",
    "html-to-image": "^1.11.13",
    "nuxt": "~4.3.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@nuxt/eslint": "^1.0.0",
    "@nuxt/test-utils": "^3.19.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^4.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "happy-dom": "^20.11.1",
    "sql.js": "^1.14.1",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
